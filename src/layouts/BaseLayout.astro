---
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '../lib/posts';
import SiteNav from '../components/SiteNav.astro';
import { alternateHreflang, bcp47 } from '../lib/i18n/routing';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** 不含語言前綴的正規路徑，例如 /writing */
  path: string;
  current: 'home' | 'writing' | 'about';
  /**
   * 這個路由會播放入侵序列（只有首頁兩個語言版本是 true）：`seq-pending` 只能
   * 由真的會有人來解除它的頁面設定。門面／閱讀的分界不靠 prop，靠
   * `src/lib/routes.ts` 的路由判定——執行期換頁時才有辦法重新決定。
   */
  sequence?: boolean;
  /**
   * 實際存在對應頁面的語言集合。預設為全部語言（首頁、about、writing 索引頁
   * 兩種語言都存在）。標籤頁與文章頁的手足 URL 不保證存在，那些頁面要傳入只
   * 含真的存在的語言，避免產生指向 404 的 hreflang。
   */
  availableLocales?: Locale[];
}

const { locale, title, description, path, current, sequence = false, availableLocales } = Astro.props;
const alternates = alternateHreflang(path, availableLocales);
const htmlLang = bcp47(locale);
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, Astro.site)} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {sequence && (
      <script is:inline>
        (function () {
          try {
            var played = sessionStorage.getItem('hh.sequence.played') === '1';
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!played && !reduced) {
              document.documentElement.classList.add('seq-pending');
            }
          } catch (e) {
            /* sessionStorage 可能被封鎖；封鎖時不播序列即可 */
          }
        })();
      </script>
    )}
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <!-- 抖色 canvas 與故障分層的家。跨頁保留，避免換頁時被抽掉。 -->
    <div id="fx" transition:persist aria-hidden="true">
      <canvas id="dither-canvas"></canvas>
      <div id="fx-layers"></div>
    </div>

    <SiteNav locale={locale} current={current} path={path} availableLocales={availableLocales} />
    <slot />

    <script>
      import { initNavGlitch } from '../lib/nav-glitch';
      initNavGlitch();
    </script>
  </body>
</html>
