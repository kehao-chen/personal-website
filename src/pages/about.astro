            <th>Issuer</th>
            <th>Verification</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Azure Solutions Architect Expert</td>
            <td>Microsoft</td>
            <td><a href="https://learn.microsoft.com/api/credentials/share/en-us/kehao-chen/5C1C6D2DCE6C5DAE?sharingId=339B6985F6579064" target="_blank" rel="noopener noreferrer">verify</a></td>
          </tr>
          <tr>
            <td>DevOps Engineer Expert</td>
            <td>Microsoft</td>
            <td><a href="https://learn.microsoft.com/api/credentials/share/en-us/kehao-chen/88780FEC56298A7D?sharingId=339B6985F6579064" target="_blank" rel="noopener noreferrer">verify</a></td>
          </tr>
          <tr>
            <td>Azure Administrator Associate</td>
            <td>Microsoft</td>
            <td><a href="https://learn.microsoft.com/api/credentials/share/en-us/kehao-chen/AA2D84683A352AC?sharingId=339B6985F6579064" target="_blank" rel="noopener noreferrer">verify</a></td>
