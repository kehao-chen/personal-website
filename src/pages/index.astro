---
import FrontLayout from '../layouts/FrontLayout.astro';
import VimWindow from '../components/VimWindow.astro';
import DesktopIcon from '../components/DesktopIcon.astro';
import Wordmark from '../components/Wordmark.astro';
import HeroSequence from '../components/HeroSequence.astro';
import { t } from '../lib/i18n/ui';
---
<FrontLayout
  locale="en"
  title="KEHAO — happyhacking.ninja"
  description="Cloud-native and AI infrastructure. Notes mostly in 中文, occasionally English."
  path="/"
  current="home"
  sequence={true}
>
  <Wordmark />
  <HeroSequence locale="en" />
  <main id="main-content" class="page layout-front" tabindex="-1">
    <div class="desktop">
      <DesktopIcon label=".profile" action={t('en', 'profile.open')} controls="profile-window" />
      <VimWindow path="~/.profile" id="profile-window" closeLabel={t('en', 'profile.close')}>
        <p class="vim-line">INTJ-O-H · Thoroughly average 1x engineer.</p>
        <p class="vim-line">Hauling bricks in Azure &amp; K8s. Anxiety is just compute starvation.</p>
        <p class="vim-line soft">STATUS <span class="hot">ONLINE</span> · TAIPEI · GITHUB <a href="https://github.com/kehao-chen" target="_blank" rel="noopener noreferrer">@kehao-chen</a></p>
      </VimWindow>
    </div>
  </main>

  <script>
    import { initProfileWindow } from '../lib/profile-window';
    initProfileWindow();
  </script>
</FrontLayout>
