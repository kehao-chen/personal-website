---
import type { Locale } from '../lib/posts';
import { bcp47, localeSwitchTarget, localizePath } from '../lib/i18n/routing';
import { t } from '../lib/i18n/ui';

interface Props {
  locale: Locale;
  current: 'home' | 'writing' | 'about';
  /** 目前頁面不含語言前綴的正規路徑，換語系時用來留在同一頁 */
  path: string;
  /** 這一頁實際存在的語言集合；目標語言不在裡面時換語系會退到區段根 */
  availableLocales?: Locale[];
}

const { locale, current, path, availableLocales } = Astro.props;

const links = [
  { key: 'home' as const, href: localizePath(locale, '/'), label: t(locale, 'nav.home') },
  { key: 'writing' as const, href: localizePath(locale, '/writing'), label: t(locale, 'nav.writing') },
  { key: 'about' as const, href: localizePath(locale, '/about'), label: t(locale, 'nav.about') },
];

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const langHref = localeSwitchTarget(otherLocale, path, availableLocales);
---

<nav class="site-nav">
  <a class="brand" href={localizePath(locale, '/')}>HAPPYHACKING.NINJA</a>
  {links.map((link) => (
    <a
      href={link.href}
      class:list={['nav-link', { on: link.key === current }]}
      aria-current={link.key === current ? 'page' : undefined}
    >{link.label}</a>
  ))}
  <!-- lang/hreflang 讓螢幕閱讀器用正確的語音唸「中文」，而不是照英文拼 -->
  <a class="nav-lang" href={langHref} hreflang={bcp47(otherLocale)} lang={bcp47(otherLocale)}>
    {otherLocale === 'zh' ? '中文' : 'EN'}
  </a>
</nav>
