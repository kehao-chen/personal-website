---
import type { Locale } from '../lib/posts';
import { t } from '../lib/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<pre id="boot-log" aria-hidden="true"></pre>
<!-- 預設隱藏：只有真的要播序列的那一次由 site-dither 揭露它。
     沒有 JS 的訪客不會看到一個永遠不會發生的「按任意鍵跳過」。 -->
<p id="skip-hint" aria-hidden="true" hidden>{t(locale, 'skip.sequence')}</p>

<script>
  import { initSiteDither } from '../lib/site-dither';
  initSiteDither();
</script>
